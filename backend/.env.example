# Default: SQLite, zero setup (development fallback).
DATABASE_URL=sqlite:///./geomeasure.db
# PostgreSQL (intended production database): uncomment and adjust.
# DATABASE_URL=postgresql+psycopg://geomeasure:geomeasure@localhost:5432/geomeasure

UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=25
MAX_EXTRACTED_MB=200
MAX_FEATURES=20000

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
